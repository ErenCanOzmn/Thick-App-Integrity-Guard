<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.4.0</Version>
    <PackageId>IntegrityGuard</PackageId>
    <RepositoryUrl>https://github.com/ErenCanOzmn/Thick-App-Integrity-Guard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Signed file snapshots and bounded Windows x64 runtime native-entry checks. Local defense in depth, not process attestation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/screenshots/*.png" Pack="true" PackagePath="assets/screenshots/" />
    <None Include="../../docs/INTEGRATION.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/DEPLOYMENT.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/NATIVE.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/RUNTIME.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/EXAMPLE-APPS.md" Pack="true" PackagePath="docs/" />
    <None Include="../../samples/CustomerIntegration/ProtectedRules.cs" Pack="true" PackagePath="samples/CustomerIntegration/" />
  </ItemGroup>
</Project>
